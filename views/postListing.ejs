<!DOCTYPE html>
<html lang = "en">
  <head>
    <title><%= title %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/output.css">
    <link rel="stylesheet" href="/style.css">
    <script src = "/app.js" defer></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>

  <body class="bg-[#f3f6f8] text-[#1b2430] font-sans leading-loose">
    <%- include('partials/header') %>
    <main class="max-w-[45rem] mx-auto px-4 py-8">
      <h1 class="text-2xl font-bold mb-4"><%= title %></h1>

      <form method="POST" action= "/listings/classic" class="grid gap-3 max-w-[30rem]">
        <input name = "listing" class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white" placeholder="Listing" required>
        <input name = "amount" class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white" type = "number" step = "0.01" placeholder="Amount" required>
        <textarea name="description" placeholder="Description" class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white"></textarea>
        <button type= "submit" class="px-4 py-2 rounded-md bg-blue-700 text-white font-semibold hover:bg-blue-800 cursor-pointer">Add listing</button>

      </form>
      <% if (entries.length === 0){ %>
        <p class="mt-4"> No listings yet.</p>
      <%} else { %>
      <ul class="mt-6 grid gap-4">
        <% entries.forEach(entry=>{ %>
          <li data-id="<%= entry.id %>" class="bg-white border border-[#2b2a2a] rounded-[10px] px-4 sm:px-8 py-4">
          <div class="view">
            <h2 class="text-lg font-semibold"><%= entry.listing %></h2>
            <p><%= entry.amount %></p>
            <p><%= entry.description %></p>
            <div class="flex gap-2 mt-2">
              <button type="button" class="delete-btn px-3 py-1 rounded-md border border-red-600 text-red-600 hover:bg-red-50 cursor-pointer"
              hx-delete="/listings/<%= entry.id %>"
              hx-target="closest li"
              hx-swap="outerHTML"
              hx-confirm="Are you sure you want to delete your listing?"
              hx-disabled-elt="this"
              >Delete</button>

              <button type="button" class="edit-btn px-3 py-1 rounded-md border border-gray-400 hover:bg-gray-100 cursor-pointer">Edit</button>
            </div>
          </div>
          <form class="edit-form grid gap-3 max-w-[30rem]" hidden>
              <input name="listing" class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white" value= "<%= entry.listing %>" required>
              <input name="amount" type="number" class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white" step="0.01" value="<%= entry.amount %>" required>
              <textarea name="description" class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white"><%= entry.description %></textarea>
              <div class="flex gap-2 mt-2">
                <button type="submit" class="px-4 py-2 rounded-md bg-blue-700 text-white font-semibold hover:bg-blue-800 cursor-pointer">Save</button>
                <button type="button" class="cancel-btn px-4 py-2 rounded-md border border-gray-400 hover:bg-gray-100 cursor-pointer">Cancel</button>
              </div>

          </form>
          </li>
        <% }) %>
      </ul>
      <% } %>
    </main>
  </body>
</html>
