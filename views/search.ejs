<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/output.css">
    <link rel="stylesheet" href="/style.css">
  </head>
  <body class="bg-[#f3f6f8] text-[#1b2430] font-sans leading-loose">
    <%- include('partials/header') %>
    <main class="max-w-[45rem] mx-auto px-4 py-8">
      <form class= "grid gap-3 max-w-[30rem]" method="GET" action="/search">
        <input class="w-full px-4 py-2 border border-[#2b2a2a] rounded-[5px] bg-white" type="text" name="q" placeholder="Search listings" maxlength = "100" required>
        <button type="submit" class="px-4 py-2 rounded-md bg-blue-700 text-white font-semibold hover:bg-blue-800 cursor-pointer">Search</button>
      </form>

      <% if (query) { %>
        <p>"<%= query %>" (<%= entries.length %> results) </p>
      <% } %>

      <% if (entries.length === 0) { %>
        <p class="mt-4">Sorry, no listings found.</p>
      <% } else { %>
      <ul class="mt-6 grid gap-4">
        <% entries.forEach((entry) => { %>
          <li class="bg-white border border-[#2b2a2a] rounded-[10px] px-4 sm:px-8 py-4">
          <%= entry.listing %>
          <%= entry.amount %>
          <%= entry.description %>
          </li>
        <% }); %>
      </ul>
      <% } %>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
